\cs_new_protected:Npn \__xeCJK_visible_space_fallback_auxi:N #1
  {
    \cs_if_exist:NF #1
      { \__xeCJK_visible_space_fallback_auxii:N #1 }
    \tl_set:Nn \l__xeCJK_visible_space_tl {#1}
