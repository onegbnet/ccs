\cs_new_protected:Npn \__xeCJK_ulem_periodic_clipped_leaders:nnn #1#2#3
  {
    \skip_set:Nn \l__xeCJK_tmp_skip { #1 - #2 - #3 }
    \dim_compare:nNnTF { \l__xeCJK_tmp_skip } > { \c_zero_dim }
      {
        \tex_kern:D \dim_eval:n {#2}
        \tex_special:D { x:gsave }
        \tex_special:D
          {
            pdf:literal~
            0~
            \dim_to_decimal_in_bp:n { - \box_dp:N \ULC@box - 1pt } ~
            \dim_to_decimal_in_bp:n { \l__xeCJK_tmp_skip } ~
            \dim_to_decimal_in_bp:n
              { \box_ht:N \ULC@box + \box_dp:N \ULC@box + 2pt } ~
            re~W~n
          }
        \tex_kern:D \dim_eval:n { - 2 \UL@pixel }
        \xeCJK_no_break:
        \UL@leadtype
          \skip_horizontal:n { \l__xeCJK_tmp_skip + 4 \UL@pixel }
        \tex_kern:D \dim_eval:n { - 2 \UL@pixel }
        \tex_special:D { x:grestore }
        \tex_kern:D \dim_eval:n {#3}
      }
      { \skip_horizontal:n {#1} }
