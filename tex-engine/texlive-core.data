          { \__xeCJK_use_punct_dim:nNN { bound } \c__xeCJK_right_tl #1 }
      }
      {
        \dim_min:nn
          { \__xeCJK_use_punct_dim:nNN { bound } \c__xeCJK_left_tl  #2 }
          { \__xeCJK_use_punct_dim:nNN { bound } \c__xeCJK_right_tl #2 }
