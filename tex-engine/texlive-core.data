  \ifHy@texht
  \else
    \ifx\Hy@driver\@empty
    \else
      \def\Hy@temp{hxetex}%
      \ifxetex
        \ifx\Hy@driver\Hy@temp
        \else
          \Hy@WarningNoLine{%
            Wrong driver `\Hy@driver.def';\MessageBreak
