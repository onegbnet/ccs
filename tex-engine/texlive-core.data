        \def\Hy@temp{#3}%
        \ifx\Hy@temp\@empty
          \csname l@#1\endcsname{%
            \Hy@toclinkstart{#2}\Hy@toclinkend
          }{}%
        \else
          \csname l@#1\endcsname{%
            \Hy@toclinkstart{#2}\Hy@toclinkend
          }{%
            \Hy@toclinkstart{#3}\Hy@toclinkend
          }%
        \fi
      \fi
    \fi
  }
}{}
