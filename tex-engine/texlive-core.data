  { The~command~`#1'~already~has~an~xeCJK~boundary~registration. }
\__xeCJK_msg_new:nn { boundary-register-late }
  {
    The~`experiment/boundary-register'~option~can~only~be~used~before~
    the~end~of~the~preamble.
  }
\__xeCJK_msg_new:nn { boundary-register-undefined }
