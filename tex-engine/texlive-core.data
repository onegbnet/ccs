    \f@nchdrbox@align cl\@nil{#3}%
  \else
    \f@nchdrbox@align #1\@nil{#3}%
  \fi
\endgroup
}
\protected\def\f@nchdrbox@cr{%
  {\ifnum0=`}\fi\@ifstar\@f@nchdrbox@xcr\@f@nchdrbox@xcr}

\def\@f@nchdrbox@xcr{%
