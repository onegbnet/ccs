  {\expandafter\f@nch@ifin\tmpf@ra{eolcrhf,EOLCRHF}%
    {}{\edef\temp@c{\temp@c\tmpf@ra}}}%
  \ifx\@empty\temp@c\else \PackageError{fancyhdr}{Illegal char `\temp@c' in
    \string#2 argument: [#4]}{}%
