 {\def\HyOpt@CustomDriver{hgeneric-testphase}}
 {\let\HyOpt@CustomDriver\@empty}

\define@key{Hyp}{customdriver}{%
  \IfFileExists{#1.def}{%
    \def\HyOpt@CustomDriver{#1}%
