            { -2 } { 18   bp } ,
            {  2 } { 22   bp } ,
            { -1 } { 24   bp } ,
            {  1 } { 26   bp } ,
            { -0 } { 36   bp } ,
            {  0 } { 42   bp }
          }
          { \__ctex_save_font_size:nn #1 }
      }
      { letterpress }
      {
