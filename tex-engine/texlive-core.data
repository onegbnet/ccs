\newif\iftcb@resetcounteronoverlays
\newif\iftcb@wrap@environment
\newif\iftcb@isbreakable

\newbox\tcb@titlebox
\newbox\tcb@upperbox
\newbox\tcb@lowerbox
\newbox\tcb@phantombox

\newcounter{tcbbreakpart}
\newcounter{tcblayer}
\newcounter{tcolorbox@number}

\ExplSyntaxOn
\bool_new:N \l__tcobox_prevent_init_overwrite_bool
\bool_new:N \l__tcobox_savebox_construction_bool
\box_new:N \l__tcobox_tmpa_box
\dim_new:N \l__tcobox_tmpa_dim
\fp_new:N \l__tcobox_tmpa_fp
