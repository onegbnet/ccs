  \f@nch@gbl\def\f@nch@Oelh{\f@nch@offselh}%
  \f@nch@gbl\def\f@nch@Oorh{\hss}%
  \f@nch@gbl\def\f@nch@Oerh{\hss}%
  \f@nch@gbl\def\f@nch@Oolf{\f@nch@offsolf}%
  \f@nch@gbl\def\f@nch@Oelf{\f@nch@offself}%
