\NeedsTeXFormat{LaTeX2e}[2005/12/01]
\ProvidesPackage{metalogo}[2010/05/29 v0.12 Extended TeX logo macros]
\RequirePackage{graphicx}
\RequirePackage{ifxetex}
\ifxetex
  \RequirePackage{fontspec}[2008/08/09]
