  \newtoks\Field@toks
  \Field@toks={ }%
  \def\Field@addtoks#1#2{%
    \edef\@processme{\Field@toks{\the\Field@toks\space #1="#2"}}%
    \@processme
  }%
\else
  \def\Hy@WarnHTMLFieldOption#1{%
    \Hy@Warning{%
      HTML field option `#1'\MessageBreak
      is ignored%
