      \fi
    \else
      \ifx\Hy@driver\Hy@temp
        \Hy@WarningNoLine{%
          Wrong driver `\Hy@driver.def';\MessageBreak
          pdfTeX is not running in PDF mode.\MessageBreak
          Using default driver%
        }%
        \let\Hy@driver\@empty
      \fi
    \fi
