  \@ifundefined{XeTeXversion}{}{%
    \chardef\x=3\relax
  }%
  \else
    \ifnum\luatexversion>85
      \ifnum\outputmode>0
      \chardef\x=4\relax
      \fi
    \else
      \ifnum\pdfoutput>0
      \chardef\x=1\relax
      \fi
    \fi
  \fi
\expandafter\endgroup
\ifcase\x
  % default case
  \def\Gin@driver{dvips.def}%
  \ExecuteOptions{dvips}%
