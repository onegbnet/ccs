\def\HyPsd@CJK@Unicode#1#2{%
  \ifnum#1<256 %
    \HyPsd@DecimalToOctalFirst{#1}%
    \HyPsd@DecimalToOctalSecond{#2}%
  \else
    \933%
    \expandafter\expandafter\expandafter\HyPsd@HighA
    \intcalcDiv{#1}{4}!%
    \933%
    \ifcase\intcalcMod{#1}{4} %
      4\or 5\or 6\or 7%
    \fi
    \HyPsd@DecimalToOctalSecond{#2}%
  \fi
}
\def\HyPsd@HighA#1!{%
