              { \__xeCJK_punct_if_right:NTF #2 { bound } { margin } }
              \c__xeCJK_left_tl #2 )
        - ( \__xeCJK_use_punct_dim:nNN
              { \__xeCJK_punct_if_right:NTF #3 { margin } { bound } }
              \c__xeCJK_right_tl #3 )
        - ( \__xeCJK_use_punct_dim:nN { dimen } #2 )
        - ( \__xeCJK_use_punct_dim:nN { dimen } #3 )
