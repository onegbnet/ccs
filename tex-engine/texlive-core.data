      \fi
      \ifx\@Alph\Hy@Test@Alph
      \else
        \def\@Alph{Alph\number}%
      \fi
      \ifHy@naturalnames
        \let\textlatin\@firstofone
        \xdef\HyperGlobalCurrentHref{\csname the#1\endcsname}%
      \else
        \xdef\HyperGlobalCurrentHref{%
          \csname
            the%
