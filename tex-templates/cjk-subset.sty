%% cjk-subset.sty — 把上游中文模板的字族接到我们的 Noto 子集字体。
%%
%% **字族不能拍平**:ctex 生态按 宋/黑/楷/仿宋 四族设计版式,全指同一个文件会把
%% 上游的版式意图抹掉(resumecls 的正文本该是宋体,拍平后成了黑体 —— 踩过)。
%%   CJKmain / zhsong → 思源宋体(正文,中文简历的传统正文体)
%%   CJKsans / zhhei  → 思源黑体(标题与强调)
%%   粗体             → **真粗体字面**(cjk-sc-bold),不用 AutoFakeBold 合成
%%   zhkai / zhfs     → 暂别名到宋体(简历几乎不用楷体/仿宋,不为它们多驮 12MB)
%%
%% 字体随编译喂进 CWD(故 Path=./),由 texEngineAssets() 按 .tex 自报的需要去
%% 引擎资产目录取 —— **字体不进数据包**,拉丁简历不驮 CJK 字形。
%% **字族不能拍平**:上游(ctex 生态)按 宋/黑/楷/仿宋 四族设计版式,全指同一个文件
%% 会把它的版式意图抹掉——resumecls 的正文本该是宋体,拍平后成了黑体。
%%   CJKmain / zhsong  → 思源宋体(正文,中文简历的传统正文体)
%%   CJKsans / zhhei   → 思源黑体(标题与强调)
%%   粗体              → **真粗体字面**,不再 AutoFakeBold 合成
%%   zhkai / zhfs      → 暂别名到宋体(简历几乎不用楷体/仿宋,不为它们多驮 12MB)
\ProvidesPackage{cjk-subset}[2026/08/14 cvb CJK subset binding]
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\setCJKmainfont[Path=./,BoldFont=cjk-sc-bold.otf,AutoFakeSlant=0.15]{cjk-sc-serif.otf}
\setCJKsansfont[Path=./,BoldFont=cjk-sc-bold.otf,AutoFakeSlant=0.15]{cjk-sc.otf}
\setCJKmonofont[Path=./,BoldFont=cjk-sc-bold.otf]{cjk-sc.otf}
\setCJKfamilyfont{zhsong}[Path=./,BoldFont=cjk-sc-bold.otf]{cjk-sc-serif.otf}
\setCJKfamilyfont{zhhei}[Path=./,BoldFont=cjk-sc-bold.otf]{cjk-sc.otf}
\setCJKfamilyfont{zhkai}[Path=./,AutoFakeSlant=0.15]{cjk-sc-serif.otf}
\setCJKfamilyfont{zhfs}[Path=./]{cjk-sc-serif.otf}
\providecommand{\songti}{\CJKfamily{zhsong}}
\providecommand{\heiti}{\CJKfamily{zhhei}}
\providecommand{\kaishu}{\CJKfamily{zhkai}}
\providecommand{\fangsong}{\CJKfamily{zhfs}}
